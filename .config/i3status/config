# man i3status

general {
        colors = true
        interval = 5
        # separator = "" 
}

order += "ipv6"
order += "wireless _first_"
order += "ethernet _first_"
# order += "battery all"
order += "volume master"
order += "cpu_usage"
order += "cpu_temperature 0"
order += "memory"
order += "disk /"
order += "tztime local"

ipv6 {
        format_up = "IPv6: Up"
        format_down = "IPv6: down"
}

wireless _first_ {
        format_up = "W: (%quality at %essid) %ip"
        format_down = "W: down"
}

ethernet _first_ {
        # format_up = "E: %ip (%speed)"
        format_up = "E: Up"
        format_down = "E: down"
}

battery all {
        format = "%status %percentage %remaining"
}

volume master {
        format = "V: %volume"
        format_muted = "V: muted (%volume)"
        device = "pulse"
}

cpu_usage {
        format = "CPU: %usage"
}

cpu_temperature 0 {
        format = "T: %degrees°C"
        path = "/sys/class/hwmon/hwmon2/temp1_input"
}

memory {
        format = "RAM: %used/%available"
        threshold_degraded = "1G"
        format_degraded = "MEMORY < %available"
}

disk / {
        format = "DISK : %avail/%total"
}

tztime local {
        format = "%d-%b-%Y %I:%M%P"
}
